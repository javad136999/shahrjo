# ShahrJo Nginx (production, optional profile — see docker-compose.prod.yml).
# Rendered by the official nginx image envsubst: ${SERVER_NAME} comes from
# compose env; nginx runtime vars ($host, ...) stay untouched.
#
# Routes follow the REAL endpoints of the project:
#   /api/*        -> api (NestJS, global prefix /api/v1)
#   /api/v1/files/* -> api (uploads; the API itself answers with
#                      `Cache-Control: public, max-age=31536000, immutable`)
#   /*            -> web (Next.js :3000; the admin panel lives at /admin
#                      inside this same app — there is no separate admin app)
# No WebSocket/Socket.IO service exists: the city wall chat polls over HTTP
# every 5s, so no upgrade/proxy_read block is needed here.
#
# SSL: after DNS points here, run certbot (docs/deploy.md §3) and enable the
# TLS server block commented at the bottom of this file.

upstream shahrjo_web {
    server web:3000;
}

upstream shahrjo_api {
    server api:4000;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    client_max_body_size 20m; # ad/business images

    # API — everything under /api/ (incl. auth, payments callback, uploads).
    # X-Real-IP must reach the API: OTP/rate-limit policy keys on it.
    location /api/ {
        proxy_pass http://shahrjo_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploaded files (real path /api/v1/files/*). The API already sets the
    # long-lived immutable Cache-Control; proxy_pass forwards it as-is.
    # No proxy_cache/add_header here on purpose: both would duplicate the
    # upstream header instead of improving caching.
    location /api/v1/files/ {
        proxy_pass http://shahrjo_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js frontend (PWA) — pages, assets, and /admin panel.
    location / {
        proxy_pass http://shahrjo_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

