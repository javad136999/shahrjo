# ShahrJo Nginx (production). Rendered by the official nginx image envsubst:
# ${SERVER_NAME} comes from compose env; nginx runtime vars ($host, ...) stay untouched.
# SSL: after DNS points here, run certbot (docs/deploy.md) and enable the TLS server block.

upstream shahrjo_api {
    server api:4000;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    client_max_body_size 20m; # ad/business images

    # WebSocket (public city chat)
    location /socket.io/ {
        proxy_pass http://shahrjo_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Uploaded files: long-lived cache (ETag + Cache-Control => less bandwidth)
    location /files/ {
        proxy_pass http://shahrjo_api;
        proxy_set_header Host $host;
        proxy_cache_valid 200 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        proxy_pass http://shahrjo_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
