// ShahrJo - Phase 1: Architecture + Database
// Multi-city schema. No city is ever hard-coded; everything is DB-driven.
// Money amounts are BigInt (Rial). Transactions-like tables are append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= Enums =================

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum AdStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SOLD
  DELETED
}

enum NewsStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
  DELETED
}

enum OtpPurpose {
  LOGIN
}

enum FavoriteTarget {
  AD
  BUSINESS
}

enum CommentTarget {
  AD
  BUSINESS
  NEWS
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ChatRoomType {
  CITY_PUBLIC
}

enum ChatReportReason {
  SPAM
  ABUSE
  SCAM
  HARASSMENT
  OTHER
}

enum ChatReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum MapLocationKind {
  PLACE
  SERVICE
  TRANSPORT
  HEALTH
  EDUCATION
  GOVERNMENT
}

enum NotificationType {
  SYSTEM
  AD_APPROVED
  AD_REJECTED
  MESSAGE
  REPORT_RESOLVED
  PAYMENT
}

// ================= Geo (multi-city) =================

model Province {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities     City[]
  adminUsers AdminUser[]

  @@map("provinces")
}

model City {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  slug       String   @unique @db.VarChar(100)
  // Map center (no hard-coded cities anywhere else)
  latitude   Float?
  longitude  Float?
  isFeatured Boolean  @default(false) @map("is_featured")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  province     Province      @relation(fields: [provinceId], references: [id])
  users        User[]
  businesses   Business[]
  ads          Ad[]
  news         News[]
  chatRoom     ChatRoom?
  banners      Banner[]
  mapLocations MapLocation[]
  adminUsers   AdminUser[]

  @@index([provinceId])
  @@map("cities")
}

// ================= Users & Auth =================

model User {
  id          Int        @id @default(autoincrement())
  phone       String     @unique @db.VarChar(15)
  fullName    String?    @map("full_name") @db.VarChar(120)
  avatarUrl   String?    @map("avatar_url")
  cityId      Int?       @map("city_id") // selected city (first-run selection)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  city          City?          @relation(fields: [cityId], references: [id])
  profile       UserProfile?
  sessions      UserSession[]
  ads           Ad[]
  favorites     Favorite[]
  comments      Comment[]
  reviews       Review[]
  chatMessages  ChatMessage[]
  chatReports   ChatReport[]   @relation("ChatReportReporter")
  notifications Notification[]
  adminProfile  AdminUser?
  businesses    Business[]

  @@index([cityId])
  @@map("users")
}

model UserProfile {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  bio       String?
  gender    String?   @db.VarChar(10)
  birthDate DateTime? @map("birth_date")
  email     String?   @unique
  website   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// OTP is stored hashed (never raw), one-time-use, with expiry + attempt limits.
model OtpCode {
  id          Int        @id @default(autoincrement())
  phone       String     @db.VarChar(15)
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  lastIp      String?    @map("last_ip") @db.VarChar(45)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ================= RBAC =================

model Role {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50) // SUPER_ADMIN | PROVINCE_ADMIN | CITY_ADMIN | MODERATOR | BUSINESS_OWNER | USER
  title     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  adminUsers  AdminUser[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(100) // e.g. ads.moderate
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Admin panel operator. Scoped by province/city so CITY_ADMIN only sees its city.
model AdminUser {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  roleId     Int      @map("role_id")
  provinceId Int?     @map("province_id")
  cityId     Int?     @map("city_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])

  auditLogs AuditLog[]

  @@index([roleId])
  @@map("admin_users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int?     @map("admin_user_id")
  action      String   @db.VarChar(100) // e.g. ad.approve
  entity      String   @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(50)
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ================= Ads (marketplace) =================

model AdCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  icon      String?
  color     String?  @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  ads Ad[]

  @@map("ad_categories")
}

model Ad {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  cityId         Int       @map("city_id")
  categoryId     Int       @map("category_id")
  title          String    @db.VarChar(160)
  description    String
  price          BigInt? // Rial
  phone          String?   @db.VarChar(15)
  address        String?
  latitude       Float?
  longitude      Float?
  status         AdStatus  @default(PENDING)
  viewCount      Int       @default(0) @map("view_count")
  rejectedReason String?   @map("rejected_reason")
  expiresAt      DateTime? @map("expires_at")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  city         City          @relation(fields: [cityId], references: [id])
  category     AdCategory    @relation(fields: [categoryId], references: [id])
  images       AdImage[]
  favorites    Favorite[]
  comments     Comment[]
  mapLocations MapLocation[]

  @@index([cityId, categoryId, status])
  @@index([userId])
  @@index([status, createdAt])
  @@map("ads")
}

model AdImage {
  id        Int      @id @default(autoincrement())
  adId      Int      @map("ad_id")
  url       String // path/URL only - never binary data in Postgres
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@map("ad_images")
}

// ================= Business directory =================

model BusinessCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  icon      String?
  color     String?  @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  businesses Business[]

  @@map("business_categories")
}

model Business {
  id           Int            @id @default(autoincrement())
  cityId       Int            @map("city_id")
  categoryId   Int            @map("category_id")
  ownerId      Int            @map("owner_id")
  name         String         @db.VarChar(160)
  slug         String         @unique @db.VarChar(180)
  description  String?
  logoUrl      String?        @map("logo_url")
  coverUrl     String?        @map("cover_url")
  phone        String?        @db.VarChar(15)
  address      String?
  latitude     Float?
  longitude    Float?
  workingHours Json?          @map("working_hours") // [{ day, open, close }]
  socialLinks  Json?          @map("social_links") // { instagram, telegram, website, ... }
  rating       Float          @default(0)
  ratingCount  Int            @default(0) @map("rating_count")
  viewCount    Int            @default(0) @map("view_count")
  status       BusinessStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  city         City             @relation(fields: [cityId], references: [id])
  category     BusinessCategory @relation(fields: [categoryId], references: [id])
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviews      Review[]
  favorites    Favorite[]
  comments     Comment[]
  mapLocations MapLocation[]

  @@index([cityId, categoryId, status])
  @@index([ownerId])
  @@map("businesses")
}

model Review {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  userId     Int      @map("user_id")
  rating     Int // 1..5
  body       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("reviews")
}

// ================= News =================

model NewsCategory {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  slug      String  @unique @db.VarChar(100)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  news News[]

  @@map("news_categories")
}

model News {
  id          Int        @id @default(autoincrement())
  cityId      Int        @map("city_id")
  categoryId  Int?       @map("category_id")
  authorId    Int?       @map("author_id")
  title       String     @db.VarChar(200)
  slug        String     @unique @db.VarChar(220)
  excerpt     String?
  body        String
  coverUrl    String?    @map("cover_url")
  status      NewsStatus @default(DRAFT)
  viewCount   Int        @default(0) @map("view_count")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  city     City          @relation(fields: [cityId], references: [id])
  category NewsCategory? @relation(fields: [categoryId], references: [id])
  comments Comment[]

  @@index([cityId, status, publishedAt])
  @@map("news")
}

// ================= Chat (public, per-city, realtime) =================

model ChatRoom {
  id            Int          @id @default(autoincrement())
  cityId        Int          @unique @map("city_id")
  name          String       @db.VarChar(120)
  type          ChatRoomType @default(CITY_PUBLIC)
  isActive      Boolean      @default(true) @map("is_active")
  lastMessageAt DateTime?    @map("last_message_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  city     City          @relation(fields: [cityId], references: [id])
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        Int       @id @default(autoincrement())
  roomId    Int       @map("room_id")
  userId    Int       @map("user_id")
  body      String    @db.VarChar(2000)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  room    ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ChatReport[]

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model ChatReport {
  id             Int              @id @default(autoincrement())
  messageId      Int              @map("message_id")
  reporterId     Int              @map("reporter_id")
  reason         ChatReportReason
  details        String?
  status         ChatReportStatus @default(PENDING)
  resolutionNote String?          @map("resolution_note")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User        @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("chat_reports")
}

// ================= Map =================

// Extra points of interest on the map (businesses/ads have their own coords).
model MapLocation {
  id         Int             @id @default(autoincrement())
  cityId     Int             @map("city_id")
  name       String          @db.VarChar(160)
  kind       MapLocationKind @default(PLACE)
  latitude   Float
  longitude  Float
  address    String?
  businessId Int?            @map("business_id")
  adId       Int?            @map("ad_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  ad       Ad?       @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([cityId, kind])
  @@map("map_locations")
}

// ================= Engagement =================

model Favorite {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  targetType FavoriteTarget
  adId       Int?           @map("ad_id")
  businessId Int?           @map("business_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad       Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, adId])
  @@unique([userId, businessId])
  @@index([userId, targetType])
  @@map("favorites")
}

// Exactly one of adId / businessId / newsId must be set (enforced in service layer).
model Comment {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  targetType CommentTarget
  adId       Int?          @map("ad_id")
  businessId Int?          @map("business_id")
  newsId     Int?          @map("news_id")
  body       String        @db.VarChar(1000)
  status     CommentStatus @default(VISIBLE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad       Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  news     News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([businessId])
  @@index([newsId])
  @@map("comments")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(160)
  body      String?
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Banner {
  id        Int       @id @default(autoincrement())
  cityId    Int?      @map("city_id") // null = all cities
  title     String?   @db.VarChar(160)
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  city City? @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, isActive])
  @@map("banners")
}
