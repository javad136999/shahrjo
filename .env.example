# ===== Shahrjo environment template =====
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development

# --- Domains ---
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
# Public domain of the deployment (used by Nginx server_name)
SERVER_NAME=shahrju.ir
# Canonical public host used for metadata, rel=canonical, og:url, robots.txt
# and the sitemap (apps/web/src/lib/site.ts). Keep it in sync with SERVER_NAME.
NEXT_PUBLIC_SITE_URL=https://shahrju.ir
# Daily DB backups kept in the backup volume
BACKUP_KEEP=7

# --- PostgreSQL ---
POSTGRES_USER=shahrjo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=shahrjo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shahrjo:CHANGE_ME_STRONG_PASSWORD@localhost:5432/shahrjo?schema=public

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# --- Auth / JWT (generate: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Refresh-reuse grace window (seconds): a just-rotated refresh token stays
# acceptable for this long so several restored browser tabs can race without
# being logged out. Reuse outside the window = theft (all sessions revoked).
# Logout expires the session immediately and is never grace-windowed. 0=off.
REFRESH_REUSE_GRACE_SECONDS=60

# --- OTP ---
OTP_LENGTH=5
OTP_TTL_SECONDS=120
# Alias (same value, both accepted): OTP_EXPIRES_SECONDS=120
# Pepper for hashing OTP codes before storing in PostgreSQL (generate: openssl rand -base64 48)
OTP_HASH_SECRET=CHANGE_ME_64_CHARS
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_HOUR=5
# Per-IP hourly cap + minimum seconds between two OTP requests (resend cooldown)
OTP_IP_LIMIT_PER_HOUR=20
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMS provider (abstract: console | kavenegar | smsir | ippanel - swap without touching auth) ---
SMS_PROVIDER=console
# NEVER put a real key here — real keys live only in the server .env (not in Git).
# ippanel: paste the API key EXACTLY as shown in the panel. Both forms work —
# a base64-form key is sent as-is, a raw uuid-style key is base64-encoded by
# the adapter (Edge base64-decodes the Authorization header).
SMS_API_KEY=
SMS_SENDER=            # kavenegar sender line | sms.ir line number | ippanel from_number (E.164, e.g. +983000505)
SMS_OTP_TEMPLATE=      # kavenegar template name | sms.ir numeric template id
# IPPanel/KPanel pattern OTP: leave EMPTY until the pattern is approved.
# While empty, SMS_PROVIDER=ippanel makes NO API call (OTP logged, auth works);
# setting SMS_PATTERN_CODE (+ SMS_SENDER) activates real sending — no code change.
SMS_PATTERN_CODE=
# Must equal the %variable% name inside the pattern (e.g. %user_code% -> user_code).
SMS_PATTERN_PARAM=user_code

# --- Cafe Bazaar In-App Billing ---
# The package name must exactly match the app published in Bazaar.
BAZAAR_PACKAGE_NAME=ir.shahrju.app
# Developer API access token; keep it only in the server .env, never in the app.
BAZAAR_ACCESS_TOKEN=
# RSA public key and dynamic-discount JWT key are configured for the Android build.
# Never commit real credentials or the JWT key.
BAZAAR_RSA_PUBLIC_KEY=
BAZAAR_JWT_DISCOUNT_KEY=

# --- Public wall automation ---
# Ordinary scheduled ad reposts (including test-like general ad copy).
ENABLE_WALL_REPOSTS=false
# Special promotions sourced from active GOLD businesses; independent of ordinary reposts.
ENABLE_GOLD_BUSINESS_PROMOS=true

# --- Storage (abstraction: local | s3) ---
STORAGE_DRIVER=local
# Resolved against the API container workdir (/repo/apps/api) — matches the
# shahrjo_uploads volume in docker-compose.prod.yml.
STORAGE_LOCAL_DIR=./uploads
# Empty = relative URLs (/api/v1/files/<key>), served by the API itself and
# proxied by Caddy on any domain. Set only if files live on another origin/CDN.
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
